datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id                 String   @id @default(uuid())
  name               String
  tradeName          String?
  gstin              String?
  pan                String?
  phone              String
  email              String
  currency           String   @default("INR")
  stateCode          String   @default("27")
  stateName          String   @default("Maharashtra")
  street             String   @default("")
  city               String   @default("")
  pincode            String   @default("")
  country            String   @default("India")
  isCompositionScheme Boolean @default(false)
  termsAndConditions String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  branches          Branch[]
  users             User[]
  products          Product[]
  customers         Customer[]
  invoices          Invoice[]
  sequences         InvoiceSequence[]
  syncTransactions  SyncTransaction[]
  subscription      Subscription?
  terminals         Terminal[]
  auditLogs         AuditLog[]
  paymentIntents    PaymentIntent[]
}

model Branch {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  code         String
  gstin        String?
  phone        String
  street       String   @default("")
  city         String   @default("")
  state        String   @default("")
  stateCode    String   @default("27")
  pincode      String   @default("")
  country      String   @default("India")
  isMainBranch Boolean  @default(false)
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  sequences    InvoiceSequence[]
  stockAdjustments StockAdjustment[]
  terminals    Terminal[]

  @@unique([tenantId, code])
  @@index([tenantId, code])
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  email        String   @unique
  phone        String?
  passwordHash String   @default("password123")
  role         String   @default("CASHIER") // OWNER, ADMIN, MANAGER, CASHIER
  // Branch-level access. Empty array = access to every branch of the tenant.
  branchIds    String[] @default([])
  isActive     Boolean  @default(true)
  // Incremented to revoke every JWT previously issued to this user.
  tokenVersion Int      @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, role])
}

model Product {
  id             String   @id @default(uuid())
  tenantId       String
  sku            String
  barcode        String?
  name           String
  description    String?
  category       String   @default("General")
  brand          String?
  unit           String   @default("PCS") // PCS, BOX, KG, LTR, PACK
  hsnCode        String   @default("9983")
  gstRate        Float    @default(18.0) // 0, 5, 12, 18, 28
  cessRate       Float    @default(0.0)
  purchasePrice  Decimal  @default(0.0) @db.Decimal(12, 2)
  sellingPrice   Decimal  @db.Decimal(12, 2)
  mrp            Decimal  @db.Decimal(12, 2)
  isTaxInclusive Boolean  @default(false)
  currentStock   Int      @default(0)
  minStockAlert  Int      @default(5)
  imageUrl       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceItems   InvoiceItem[]
  stockAdjustments StockAdjustment[]

  @@unique([tenantId, sku])
  @@index([tenantId, category])
  @@index([tenantId, currentStock])
}

model Customer {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  phone          String
  email          String?
  gstin          String?
  creditLimit    Decimal  @default(0.0) @db.Decimal(12, 2)
  currentBalance Decimal  @default(0.0) @db.Decimal(12, 2)
  street         String   @default("")
  city           String   @default("")
  state          String   @default("")
  stateCode      String   @default("27")
  pincode        String   @default("")
  country        String   @default("India")
  createdAt      DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  payments       Payment[]

  @@index([tenantId, phone])
  @@index([tenantId, name])
}

model Invoice {
  id                     String   @id @default(uuid())
  tenantId               String
  branchId               String
  invoiceNumber          String
  sequenceNumber         Int
  type                   String   @default("TAX_INVOICE")
  customerId             String?
  customerName           String
  customerPhone          String?
  customerGstin          String?
  customerStateCode      String?
  placeOfSupplyStateCode String
  isInterState           Boolean  @default(false)

  subTotal               Decimal  @db.Decimal(12, 2)
  totalDiscount          Decimal  @default(0.0) @db.Decimal(12, 2)
  taxableAmount          Decimal  @db.Decimal(12, 2)
  totalCgst              Decimal  @default(0.0) @db.Decimal(12, 2)
  totalSgst              Decimal  @default(0.0) @db.Decimal(12, 2)
  totalIgst              Decimal  @default(0.0) @db.Decimal(12, 2)
  totalCess              Decimal  @default(0.0) @db.Decimal(12, 2)
  totalTax               Decimal  @db.Decimal(12, 2)
  roundOff               Decimal  @default(0.0) @db.Decimal(12, 2)
  grandTotal             Decimal  @db.Decimal(12, 2)

  paymentStatus          String   @default("UNPAID") // PAID, PARTIAL, UNPAID, CANCELLED
  paidAmount             Decimal  @default(0.0) @db.Decimal(12, 2)
  balanceAmount          Decimal  @default(0.0) @db.Decimal(12, 2)
  notes                  String?
  isSynced               Boolean  @default(true)
  // Client-supplied key; a retried checkout returns the original invoice.
  idempotencyKey         String?
  terminalId             String?
  createdBy              String?
  cancelledAt            DateTime?
  cancelledBy            String?
  cancellationReason     String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                 Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer               Customer? @relation(fields: [customerId], references: [id])
  items                  InvoiceItem[]
  payments               Payment[]

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, branchId])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@index([tenantId, paymentStatus])
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  productId       String
  name            String
  sku             String
  hsnCode         String
  unit            String   @default("PCS")
  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 2)
  discountPercent Float    @default(0.0)
  discountAmount  Decimal  @default(0.0) @db.Decimal(12, 2)
  taxableAmount   Decimal  @db.Decimal(12, 2)
  gstRate         Float
  isInterState    Boolean  @default(false)
  cgstRate        Float    @default(0.0)
  cgstAmount      Decimal  @default(0.0) @db.Decimal(12, 2)
  sgstRate        Float    @default(0.0)
  sgstAmount      Decimal  @default(0.0) @db.Decimal(12, 2)
  igstRate        Float    @default(0.0)
  igstAmount      Decimal  @default(0.0) @db.Decimal(12, 2)
  cessAmount      Decimal  @default(0.0) @db.Decimal(12, 2)
  totalAmount     Decimal  @db.Decimal(12, 2)

  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id              String   @id @default(uuid())
  tenantId        String?
  invoiceId       String?
  customerId      String?
  mode            String   // CASH, UPI, CARD, NET_BANKING, CREDIT_KHATA
  amount          Decimal  @db.Decimal(12, 2) // negative for REVERSAL entries
  referenceNumber String?
  // SETTLED | REVERSED (original, after a reversal) | REVERSAL (the negative entry)
  status          String   @default("SETTLED")
  // GATEWAY_WEBHOOK | CASHIER_ATTESTED | CASH_COUNTER | KHATA_SETTLEMENT | OFFLINE_SYNC | LEGACY
  verification    String   @default("LEGACY")
  provider        String?
  providerPaymentId String?
  reversalOfId    String?
  reason          String?
  recordedBy      String?
  paidAt          DateTime @default(now())

  invoice         Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer        Customer? @relation(fields: [customerId], references: [id])

  @@unique([provider, providerPaymentId])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([customerId])
  @@index([paidAt])
}

model StockAdjustment {
  id            String   @id @default(uuid())
  productId     String
  branchId      String
  quantityDelta Int      // + for addition, - for reduction
  previousStock Int
  newStock      Int
  reason        String   // SALE, PURCHASE, DAMAGE, RETURN, AUDIT_CORRECTION, THEFT
  note          String?
  userId        String   @default("system")
  createdAt     DateTime @default(now())

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([branchId])
  @@index([createdAt])
}

model InvoiceSequence {
  id            String   @id @default(uuid())
  tenantId      String
  branchId      String
  financialYear String   // e.g. "26-27"
  lastSequence  Int      @default(0)

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, financialYear])
}

model SyncTransaction {
  id                  String   @id @default(uuid())
  clientTransactionId String
  tenantId            String
  branchId            String
  entityType          String   // INVOICE, PRODUCT, CUSTOMER, STOCK_ADJUSTMENT
  operation           String   // CREATE, UPDATE, DELETE
  entityId            String
  payload             String   // JSON string
  clientTimestamp     BigInt
  serverTimestamp     BigInt
  status              String   @default("SYNCED") // PENDING, SYNCED, CONFLICT

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientTransactionId])
  @@index([tenantId, status])
  @@index([tenantId, serverTimestamp])
}


// ============================================================================
// Phase 6: SaaS subscription, terminals, payment intents, audit trail
// ============================================================================

model Subscription {
  id                     String    @id @default(uuid())
  tenantId               String    @unique
  planTier               String    @default("STARTER_TRIAL") // STARTER_TRIAL | GROWTH | ENTERPRISE
  billingCycle           String    @default("TRIAL")         // TRIAL | MONTHLY | ANNUAL
  status                 String    @default("TRIALING")      // TRIALING | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime  @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean   @default(false)
  cancelledAt            DateTime?
  pendingPlanTier        String?
  pendingBillingCycle    String?
  paymentProvider        String?
  externalCustomerId     String?
  externalSubscriptionId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events                 SubscriptionEvent[]
}

model SubscriptionEvent {
  id              String   @id @default(uuid())
  subscriptionId  String
  provider        String
  providerEventId String
  eventType       String
  payload         String
  processedAt     DateTime @default(now())

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
}

model Terminal {
  id              String   @id @default(uuid())
  tenantId        String
  branchId        String
  terminalCode    String
  deviceName      String
  registeredBy    String
  isActive        Boolean  @default(true)
  lastHeartbeatAt DateTime @default(now())
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, terminalCode])
  @@index([tenantId, branchId])
}

// A payment request (e.g. dynamic UPI QR). Creating one is NEVER a payment
// confirmation; only a verified provider webhook moves it to SUCCEEDED.
model PaymentIntent {
  id              String   @id @default(uuid())
  tenantId        String
  invoiceId       String
  amount          Decimal  @db.Decimal(12, 2)
  provider        String
  providerOrderId String   @unique
  status          String   @default("PENDING") // PENDING | SUCCEEDED | FAILED | EXPIRED
  paymentId       String?
  expiresAt       DateTime
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
}

// Append-only. Protected from UPDATE/DELETE by a database trigger.
model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String
  userName      String
  action        String
  entityType    String
  entityId      String
  reason        String?
  previousState String?
  newState      String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
}
